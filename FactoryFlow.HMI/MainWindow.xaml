<Window x:Class="FactoryFlow.HMI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="FactoryFlow - Industrial HMI" Height="850" Width="1180" MinHeight="650" MinWidth="900">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="FactoryFlow Industrial HMI" FontSize="26" FontWeight="Bold"/>
   <WrapPanel Margin="0,10,0,8">
    <TextBlock x:Name="OperatorStatusText" Text="Operator: signed out" VerticalAlignment="Center"/>
    <Button x:Name="LoginButton" Content="Sign in with Windows" Click="Login_Click" Margin="12,0,0,0" Padding="8,4"/>
    <Button x:Name="LogoutButton" Content="Sign out" Click="Logout_Click" Margin="8,0,0,0" Padding="8,4" IsEnabled="False"/>
    <Button x:Name="BootstrapButton" Content="Set up first supervisor" Click="Bootstrap_Click" Margin="8,0,0,0" Padding="8,4" Visibility="Collapsed"/>
   </WrapPanel>
   <WrapPanel>
    <TextBlock Text="PLC: " FontWeight="Bold" VerticalAlignment="Center"/>
    <TextBlock x:Name="ConnectionStatusText" Text="DISCONNECTED" VerticalAlignment="Center"/>
    <Button x:Name="ConnectButton" Content="Connect PLC" Click="Connect_Click" Margin="12,0,20,0" Padding="8,4"/>
    <TextBlock Text="Database: " FontWeight="Bold" VerticalAlignment="Center"/>
    <TextBlock x:Name="DatabaseStatusText" Text="Connecting..." MaxWidth="470" TextWrapping="Wrap" VerticalAlignment="Center"/>
    <Button x:Name="ReloadRecipesButton" Content="Reload" Click="ReloadRecipes_Click" Margin="10,0,0,0" Padding="8,4"/>
   </WrapPanel>
   <TextBlock x:Name="ConnectionErrorText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,8"/>
  </StackPanel>
  <TabControl x:Name="FeatureTabs">
   <TabItem Header="Production">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
     <TextBlock Text="Production recipe" FontWeight="Bold"/>
     <ComboBox x:Name="RecipeComboBox" Width="340" HorizontalAlignment="Left" Margin="0,8,0,18"/>
     <TextBlock Text="Machine status" FontSize="18" FontWeight="Bold"/>
     <TextBlock x:Name="MachineStatusText" Text="UNKNOWN" FontSize="28" Margin="0,6,0,10"/>
     <TextBlock x:Name="ActualWeightText" Text="Actual Weight: — kg" FontSize="24" Margin="0,0,0,12"/>
     <TextBlock x:Name="EmergencyStopText" Text="Emergency Stop: Unknown" FontSize="17"/>
     <TextBlock x:Name="GuardClosedText" Text="Guard: Unknown" FontSize="17" Margin="0,6,0,18"/>
     <WrapPanel>
      <Button x:Name="StartBatchButton" Content="Start Batch" Width="120" Height="40" IsEnabled="False" Click="StartBatch_Click"/>
      <Button x:Name="StopBatchButton" Content="Stop Batch" Width="120" Height="40" IsEnabled="False" Margin="12,0,0,0" Click="StopBatch_Click"/>
      <Button x:Name="ResetFaultButton" Content="Reset Fault" Width="120" Height="40" IsEnabled="False" Margin="12,0,0,0" Click="ResetFault_Click"/>
     </WrapPanel>
     <GroupBox Header="Simulator interlocks" Margin="0,18,0,12"><WrapPanel Margin="10">
      <CheckBox x:Name="SimEStopCheck" Content="E-stop active" Click="SimInterlock_Click" Margin="0,0,25,0" IsEnabled="False"/>
      <CheckBox x:Name="SimGuardCheck" Content="Guard closed" Click="SimInterlock_Click" IsEnabled="False"/>
     </WrapPanel></GroupBox>
     <TextBlock Text="Production events" FontSize="18" FontWeight="Bold" Margin="0,8,0,8"/>
     <ListBox x:Name="EventListBox" Height="160"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Batch history"><DockPanel Margin="12">
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
     <TextBlock Text="From (local date) " VerticalAlignment="Center"/><DatePicker x:Name="HistoryFromPicker" Width="135"/>
     <TextBlock Text=" through " VerticalAlignment="Center"/><DatePicker x:Name="HistoryToPicker" Width="135"/>
     <ComboBox x:Name="HistoryStatusCombo" Width="120" Margin="12,0,0,0"/>
     <Button Content="Refresh history" Click="RefreshHistory_Click" Padding="8,4" Margin="12,0,0,0"/>
     <Button Content="Export CSV" Click="ExportHistory_Click" Padding="8,4" Margin="8,0,0,0"/>
    </WrapPanel>
    <TextBlock x:Name="HistorySummaryText" DockPanel.Dock="Bottom" Margin="0,8,0,0"/>
    <DataGrid x:Name="HistoryGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/>
   </DockPanel></TabItem>
   <TabItem Header="Alarms"><DockPanel Margin="12">
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
     <Button Content="Refresh alarms" Click="RefreshAlarms_Click" Padding="8,4"/>
     <CheckBox x:Name="IncludeClosedAlarmsCheck" Content="Include cleared / acknowledged" Margin="15,0,15,0" VerticalAlignment="Center"/>
     <Button x:Name="AcknowledgeButton" Content="Acknowledge selected" Click="AcknowledgeAlarm_Click" Padding="8,4" IsEnabled="False"/>
    </WrapPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="Acknowledgement records the operator response. Clear the cause and use Reset Fault to return the PLC to Idle." TextWrapping="Wrap" Margin="0,10,0,0"/>
    <DataGrid x:Name="AlarmGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/>
   </DockPanel></TabItem>
   <TabItem Header="Recipe configuration"><DockPanel Margin="12">
    <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
     <Button Content="New" Click="NewRecipe_Click" Padding="8,4"/>
     <TextBox x:Name="RecipeNameEdit" Width="240" Margin="10,0,8,0" ToolTip="Recipe name"/>
     <TextBlock Text="Target kg " VerticalAlignment="Center"/><TextBox x:Name="RecipeTargetEdit" Width="100"/>
     <CheckBox x:Name="RecipeActiveCheck" Content="Active" IsChecked="True" Margin="12,0,12,0" VerticalAlignment="Center"/>
     <Button x:Name="SaveRecipeButton" Content="Save recipe (Supervisor)" Click="SaveRecipe_Click" Padding="8,4" IsEnabled="False"/>
    </WrapPanel>
    <Button DockPanel.Dock="Top" Content="Refresh recipes" Click="RefreshRecipeGrid_Click" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,10"/>
    <DataGrid x:Name="RecipeGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" SelectionChanged="RecipeGrid_SelectionChanged"/>
   </DockPanel></TabItem>
   <TabItem Header="Operator access"><DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Text="Sign-in uses the current Windows identity. No separate application password is stored." Margin="0,0,0,12"/>
    <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
     <TextBox x:Name="OperatorAccountEdit" Width="220" ToolTip="DOMAIN\account"/>
     <TextBox x:Name="OperatorNameEdit" Width="150" Margin="8,0,8,0" ToolTip="Display name"/>
     <ComboBox x:Name="OperatorRoleCombo" Width="120"/>
     <CheckBox x:Name="OperatorEnabledCheck" Content="Enabled" IsChecked="True" Margin="12,0,12,0" VerticalAlignment="Center"/>
     <Button x:Name="SaveOperatorButton" Content="Save access (Supervisor)" Click="SaveOperator_Click" Padding="8,4" IsEnabled="False"/>
    </WrapPanel>
    <DataGrid x:Name="OperatorGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" SelectionChanged="OperatorGrid_SelectionChanged"/>
   </DockPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
