    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FactoryFlow.Core\FactoryFlow.Core.csproj" />
    <ProjectReference Include="..\FactoryFlow.Data\FactoryFlow.Data.csproj" />
    <ProjectReference Include="..\FactoryFlow.PlcClient\FactoryFlow.PlcClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
  </ItemGroup>
</Project>


