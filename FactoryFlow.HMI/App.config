<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="PlcEndpoint" value="opc.tcp://localhost:4840" />
    <add key="PlcNamespaceUri" value="urn:factoryflow:plc:line1" />
    <add key="PlcTagMapPath" value="" />
  </appSettings>
  <connectionStrings>
    <!-- Local SQL Express development certificate. Use a validated server certificate in deployed environments. -->
    <add name="FactoryFlowDB" providerName="System.Data.SqlClient"
         connectionString="Server=localhost\SQLEXPRESS;Database=FactoryFlowDB;Integrated Security=True;Connect Timeout=5;Encrypt=True;TrustServerCertificate=True;Application Name=FactoryFlow.HMI" />
  </connectionStrings>
</configuration>
